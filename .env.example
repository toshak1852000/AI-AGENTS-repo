# Database Configuration
POSTGRES_DB=portfolioq
POSTGRES_USER=portfolioq
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Celery Configuration
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# API Keys - Market Data Providers
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key_here
FRED_API_KEY=your_fred_api_key_here

# Application Settings
SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=True
LOG_LEVEL=INFO
ENVIRONMENT=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend API Configuration
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# LangGraph Configuration (if using LangSmith)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=portfolioq

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_here
SMTP_FROM=noreply@portfolioq.com

# Docker / Compose (used by docker-compose.yml)
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
GRAFANA_USER=admin
GRAFANA_PASSWORD=portfolioq_admin
MLFLOW_TRACKING_URI=http://localhost:5003
# Optional: set to avoid docker compose config warning; otherwise derived from POSTGRES_* in compose
# MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
MODEL_STORE=/app/ml_models
REPORTS_DIR=/app/reports
OPENAI_API_KEY=
